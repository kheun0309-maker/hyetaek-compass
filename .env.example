# ─────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
#
# .env 는 .gitignore 에 있어 GitHub에 올라가지 않습니다.
# GitHub Actions로 자동 실행할 때는 저장소 Settings → Secrets 에 같은 이름으로 등록하세요.
# ─────────────────────────────────────────────────────────────

# 사용할 AI 프로바이더: openai | anthropic | grok
AI_PROVIDER=openai


# ── OpenAI ────────────────────────────────────────────────────
# 키 발급: https://platform.openai.com/api-keys
# ⚠️ 결제 수단이 등록되어 있어야 API가 동작합니다 (ChatGPT Plus 구독과 별개입니다)
OPENAI_API_KEY=

# ⚠️ 본인 계정에서 실제 사용 가능한 모델 ID로 맞추세요.
#    확인 방법:  npm run doctor -- --models
OPENAI_MODEL=gpt-5.1


# ── Claude (Anthropic) ────────────────────────────────────────
# 키 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5


# ── Grok (xAI) ────────────────────────────────────────────────
# 키 발급: https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1


# ── 생성 옵션 ─────────────────────────────────────────────────
# 글 1편당 출력 토큰 상한. 2,500~3,500자 글에는 16000이면 충분합니다.
AI_MAX_TOKENS=16000

# 0에 가까울수록 일관적, 1에 가까울수록 다양함. 정보성 글은 0.6~0.8 권장.
AI_TEMPERATURE=0.7


# ── Cloudflare 배포 (선택) ────────────────────────────────────
# 이 두 값을 채우면 터미널에서 `npm run deploy` 로 바로 배포됩니다.
# (브라우저 로그인 `npx wrangler login` 을 쓰면 아래 값은 필요 없습니다)
#
# 토큰 발급: dash.cloudflare.com → 오른쪽 위 프로필 → API Tokens →
#           Create Token → "Edit Cloudflare Workers" 템플릿 사용
#           (Pages 배포에는 Account > Cloudflare Pages > Edit 권한이 필요합니다)
# 계정 ID:  dash.cloudflare.com → Workers & Pages 화면 오른쪽에 표시됩니다
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
